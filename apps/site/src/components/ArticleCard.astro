---
import type { Article } from 'shared';
import { formatDateShort, parseTags, getCategoryInfo, SOURCE_LABELS } from '../lib/data';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const tags = parseTags(article.tags as string | undefined);
const category = getCategoryInfo(article.category ?? '');
const source = SOURCE_LABELS[article.source] ?? article.source;
const date = formatDateShort(article.published_at ?? article.fetched_at);
---

<article class="card group">
  <div class="card-header-meta flex items-start justify-between gap-3 mb-3">
    <div class="flex items-center gap-2 flex-wrap">
      {article.category && (
        <span class="badge-category">{category.emoji} {category.label}</span>
      )}
      <span class="badge-source">{source}</span>
    </div>
    {date && (
      <time class="text-xs text-gray-400 dark:text-gray-500 shrink-0" datetime={article.published_at}>
        {date}
      </time>
    )}
  </div>

  <div class="card-content flex-1 min-w-0 flex flex-col justify-center">
    <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-2 leading-snug group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
      <a href={`/article/${article.slug}/`} class="block">
        {article.title_zh || article.title}
      </a>
    </h2>

    {article.summary_zh && (
      <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed line-clamp-3 mb-3">
        {article.summary_zh}
      </p>
    )}

    <div class="card-footer-meta flex items-center justify-between gap-2 mt-auto">
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((tag) => (
          <a
            href={`/tag/${tag}/`}
            class="text-xs text-gray-400 dark:text-gray-500 hover:text-brand-500 dark:hover:text-brand-400 transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
      {article.score > 0 && (
        <span class="text-xs font-medium text-gray-300 dark:text-gray-600 shrink-0">
          ▲ {article.score}
        </span>
      )}
    </div>
  </div>
</article>

<style>
  /* List view overrides */
  :global(.list-view) .card {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.25rem;
  }
  @media (min-width: 640px) {
    :global(.list-view) .card {
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
    }
    :global(.list-view) .card-header-meta {
      flex-direction: column;
      align-items: flex-end;
      width: 130px;
      shrink: 0;
      order: 3;
      margin-bottom: 0;
    }
    :global(.list-view) .card-content {
      /* flex-1 already set inline */
    }
    :global(.list-view) .card-footer-meta {
      margin-top: 0.5rem;
    }
    :global(.list-view) .card h2 {
      margin-bottom: 0.25rem;
      font-size: 1.125rem;
    }
    :global(.list-view) .card p {
      line-clamp: 2;
      -webkit-line-clamp: 2;
      margin-bottom: 0;
    }
  }
</style>

---
interface Props {
  tags: string[];
  activeTag?: string;
  maxTags?: number;
}

const { tags, activeTag, maxTags = 30 } = Astro.props;
const displayTags = tags.slice(0, maxTags);
---

{displayTags.length > 0 && (
  <div class="mb-5">
    <div class="flex items-center gap-2 mb-2.5">
      <span class="text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider">热门标签</span>
    </div>
    <div class="flex flex-wrap gap-1.5">
      {displayTags.map((tag) => (
        <a
          href={`/tag/${tag}/`}
          class={`inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium transition-colors ${
            activeTag === tag
              ? 'bg-brand-600 text-white'
              : 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-brand-50 dark:hover:bg-brand-900/30 hover:text-brand-600 dark:hover:text-brand-400'
          }`}
        >
          #{tag}
        </a>
      ))}
    </div>
  </div>
)}

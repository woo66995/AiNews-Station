    </div>

    <p class="mt-10 text-xs text-gray-400 text-center leading-relaxed">
      Elo 数据来源：<a href="https://arena.ai/leaderboard" class="text-brand-500 hover:underline" target="_blank" rel="noopener">LMSYS Chatbot Arena</a>（2026年6月）· 基于约 600 万次成对匿名投票<br/>
      编程/推理/知识评分综合 MMLU-Pro、HumanEval+、LiveCodeBench、GPQA 等公开基准归一化<br/>
      价格：每百万 Tokens 官方 API 报价 · 速度/性价比为相对评估
    </p>
  </div>
</Base>

<script>
    const MODELS = [{id:'claude-opus-4-8',name:'Claude Opus 4.8',vendor:'Anthropic',vendorColor:'#CC785C',arenaElo:1512,coding:100,reasoning:100,knowledge:98,multimodal:94,speed:40,costEff:15},{id:'claude-opus-4-7-thinking',name:'Claude Opus 4.7 Thinking',vendor:'Anthropic',vendorColor:'#CC785C',arenaElo:1500,coding:98,reasoning:100,knowledge:95,multimodal:85,speed:35,costEff:15},{id:'claude-sonnet-4-6',name:'Claude Sonnet 4.6',vendor:'Anthropic',vendorColor:'#CC785C',arenaElo:1467,coding:93,reasoning:90,knowledge:88,multimodal:83,speed:75,costEff:68},{id:'gpt-5.5-high',name:'GPT-5.5 (High)',vendor:'OpenAI',vendorColor:'#10a37f',arenaElo:1481,coding:94,reasoning:93,knowledge:93,multimodal:90,speed:45,costEff:18},{id:'llama-4.5-405b',name:'Llama 4.5 (405B)',vendor:'Meta',vendorColor:'#044E95',arenaElo:1482,coding:92,reasoning:91,knowledge:94,multimodal:89,speed:50,costEff:72},{id:'gemini-3-pro',name:'Gemini 3.0 Pro',vendor:'Google',vendorColor:'#4285f4',arenaElo:1486,coding:91,reasoning:92,knowledge:91,multimodal:94,speed:65,costEff:55},{id:'gemini-3.5-flash',name:'Gemini 3.5 Flash',vendor:'Google',vendorColor:'#4285f4',arenaElo:1480,coding:90,reasoning:88,knowledge:89,multimodal:92,speed:88,costEff:82},{id:'deepseek-v4-pro',name:'DeepSeek V4 Pro',vendor:'DeepSeek',vendorColor:'#5B6EF5',arenaElo:1456,coding:92,reasoning:89,knowledge:87,multimodal:0,speed:82,costEff:92},{id:'qwen3.7-max',name:'Qwen3.7 Max',vendor:'Alibaba (Qwen)',vendorColor:'#FF6A00',arenaElo:1463,coding:89,reasoning:88,knowledge:87,multimodal:0,speed:80,costEff:93},{id:'glm-5.1',name:'GLM 5.1',vendor:'Zhipu AI',vendorColor:'#2563EB',arenaElo:1471,coding:91,reasoning:90,knowledge:89,multimodal:78,speed:72,costEff:70},{id:'kimi-k2.6',name:'Kimi K2.6',vendor:'Moonshot AI',vendorColor:'#8B5CF6',arenaElo:1451,coding:88,reasoning:87,knowledge:86,multimodal:80,speed:68,costEff:55},{id:'mimo-v2.5-pro',name:'MiMo V2.5 Pro',vendor:'Xiaomi',vendorColor:'#FF6900',arenaElo:1465,coding:87,reasoning:86,knowledge:85,multimodal:88,speed:76,costEff:60},{id:'ernie-5.1',name:'ERNIE 5.1',vendor:'Baidu',vendorColor:'#3B82F6',arenaElo:1473,coding:85,reasoning:87,knowledge:92,multimodal:76,speed:60,costEff:58},{id:'minimax-m2.7',name:'MiniMax M2.7',vendor:'MiniMax',vendorColor:'#F59E0B',arenaElo:1420,coding:80,reasoning:82,knowledge:81,multimodal:72,speed:78,costEff:90},{id:'hunyuan-hy3',name:'Hunyuan HY3',vendor:'Tencent',vendorColor:'#00C4FF',arenaElo:1418,coding:83,reasoning:84,knowledge:83,multimodal:74,speed:70,costEff:65},{id:'grok-4.20',name:'Grok 4.20',vendor:'xAI',vendorColor:'#111111',arenaElo:1479,coding:88,reasoning:91,knowledge:90,multimodal:82,speed:55,costEff:40}];

    const vendorColors = MODELS.map(m => m.vendorColor);
    const BENCH = ['Arena Elo','编程','推理','知识','多模态','速度','性价比'];
    const visible = new Set(['claude-opus-4-8','claude-sonnet-4-6','claude-opus-4-7-thinking','gpt-5.5-high','llama-4.5-405b','gemini-3.5-flash','deepseek-v4-pro','qwen3.7-max','glm-5.1','kimi-k2.6','mimo-v2.5-pro','ernie-5.1','minimax-m2.7','hunyuan-hy3','grok-4.20']);

    function normElo(e) { return ((e - 1400) / 150) * 100; }

    function buildDatasets() {
      return MODELS.filter(m => visible.has(m.id)).map(m => {
        var c = m.vendorColor;
        return {
          label: m.name,
          data: [normElo(m.arenaElo), m.coding, m.reasoning, m.knowledge, m.multimodal, m.speed, m.costEff],
          backgroundColor: c + 'AA',
          borderColor: c,
          borderWidth: 1,
          borderRadius: 4,
        };
      });
    }

    function updateBtns() {
      var ct = document.getElementById('bar-toggles');
      if (!ct) return;
      var dk = document.documentElement.classList.contains('dark');
      ct.querySelectorAll('button').forEach(function(b) {
        var c = b.dataset.color;
        if (visible.has(b.dataset.id)) {
          b.style.borderColor = c;
          b.style.color = c;
          b.style.background = dk ? 'rgba(255,255,255,0.04)' : 'rgba(0,0,0,0.03)';
          b.style.opacity = '1';
        } else {
          b.style.borderColor = dk ? '#1f2937' : '#e5e7eb';
          b.style.color = dk ? '#4b5563' : '#9ca3af';
          b.style.background = 'transparent';
          b.style.opacity = '0.5';
        }
      });
    }

    // Immediately animate mini-bars
    document.addEventListener('DOMContentLoaded', function() {
      var bars = document.querySelectorAll('[data-bar-idx]');
      bars.forEach(function(el, i) {
        setTimeout(function() {
          el.style.width = (el.dataset.width || '0') + '%';
        }, i * 30);
      });
    });

    // Load Chart.js
    (function() {
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
      s.onload = function() {
        var dk = document.documentElement.classList.contains('dark');
        var gc = dk ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
        var tc = dk ? '#9ca3af' : '#6b7280';
        var canvas = document.getElementById('barChart');
        if (!canvas) return;

        var chart = new Chart(canvas.getContext('2d'), {
          type: 'bar',
          data: { labels: BENCH, datasets: buildDatasets() },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            scales: {
              x: { ticks: { color: tc, font: { size: 11 } }, grid: { color: gc } },
              y: { min: 0, max: 100, ticks: { stepSize: 20, color: tc, font: { size: 10 } }, grid: { color: gc } }
            },
            plugins: {
              legend: { display: false },
              tooltip: { callbacks: { label: function(c) { return ' ' + c.dataset.label + ': ' + Math.round(c.raw) + '分'; } } }
            }
          }
        });

        var ct = document.getElementById('bar-toggles');
        MODELS.forEach(function(m) {
          var c = m.vendorColor;
          var b = document.createElement('button');
          b.dataset.id = m.id;
          b.dataset.color = c;
          b.className = 'px-3 py-1.5 rounded-full text-xs font-medium border transition-all duration-200 cursor-pointer active:scale-95';
          b.innerHTML = '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:' + c + ';margin-right:6px"></span>' + m.name;
          b.addEventListener('click', function() {
            if (visible.has(m.id)) { if (visible.size > 1) visible.delete(m.id); } else { visible.add(m.id); }
            chart.data.datasets = buildDatasets();
            chart.update();
            updateBtns();
          });
          ct.appendChild(b);
        });
        updateBtns();
      };
      document.head.appendChild(s);
    })();
  </script>
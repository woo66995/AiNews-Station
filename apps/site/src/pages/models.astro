---
import Base from '../layouts/Base.astro';
import type { ModelData } from 'shared';
import { getModels } from '../lib/api';

// Data sourced dynamically from Cloudflare D1 database.
// Elo scores are Bradley-Terry Elo from ~6M pairwise human votes.
// Category scores are synthetic benchmarks normalized to 0-100 scale.

const models = (await getModels()) as ModelData[];
const modelsJson = JSON.stringify(models);

// Benchmark labels for bar chart
const benchmarkLabels = ['Arena Elo', '编程', '推理', '知识', '多模态', '速度', '性价比'];
---

<Base title="大模型能力对比 | AiNews" description="2026年6月最新 AI 模型能力柱状图对比，基于LMSYS Arena真实投票数据">
  <div class="max-w-5xl mx-auto">

    <!-- Back -->
    <a href="/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors mb-6">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      返回首页
    </a>

    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-950 dark:text-gray-50 mb-2 flex items-center gap-3">
        <span>🧠</span> 大模型能力全景对比
      </h1>
      <p class="text-gray-500 dark:text-gray-400">
        2026 年 6 月最新数据 · Arena Elo 来自 LMSYS 近 600 万人类投票 · 其余维度基于公开基准归一化
      </p>
    </div>

    <!-- Global Bar Chart (all models, all dimensions) -->
    <div class="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-6 mb-8 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5 border-b border-gray-50 dark:border-gray-800 pb-4">
        <div>
          <h2 class="text-base font-bold text-gray-900 dark:text-gray-100">📊 全维度柱状图对比</h2>
          <p class="text-xs text-gray-400 mt-0.5">点击模型名切换显示/隐藏，悬停柱状条查看详细得分</p>
        </div>
      </div>

      <!-- Toggle buttons -->
      <div id="bar-toggles" class="flex flex-wrap gap-2 mb-6"></div>

      <div class="relative" style="height: 420px;">
        <canvas id="barChart"></canvas>
      </div>
    </div>

    <!-- Individual model score breakdown bars (side-by-side) -->
    <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-4 flex items-center gap-2">
      <span>🏆</span> 模型详情
    </h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {models.map((m, idx) => {
        const maxScore = 100;
        const bars = [
          { label: 'Arena Elo', value: (m.arenaElo - 1400) / (1550 - 1400) * 100, color: '#6366f1', raw: m.arenaElo },
          { label: '编程', value: m.coding, color: '#f59e0b', raw: m.coding },
          { label: '推理', value: m.reasoning, color: '#ef4444', raw: m.reasoning },
          { label: '知识', value: m.knowledge, color: '#10b981', raw: m.knowledge },
          { label: '多模态', value: m.multimodal, color: '#8b5cf6', raw: m.multimodal },
          { label: '速度', value: m.speed, color: '#06b6d4', raw: m.speed },
          { label: '性价比', value: m.costEff, color: '#84cc16', raw: m.costEff },
        ];
        return (
          <div class="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-5 hover:border-brand-400 dark:hover:border-brand-600 transition-all duration-200">
            {/* Card header */}
            <div class="flex items-center gap-3 mb-4">
              <img
                src={m.logoUrl}
                alt={m.vendor}
                class="w-10 h-10 rounded-xl object-contain bg-gray-50 dark:bg-gray-800 p-1.5 shrink-0"
                loading="lazy"
                onerror="this.style.display='none'"
              />
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100 truncate">{m.name}</h3>
                  <span class="text-xs text-gray-400 shrink-0 bg-gray-50 dark:bg-gray-800 px-2 py-0.5 rounded-md">{m.released}</span>
                </div>
                <p class="text-xs text-gray-400">{m.vendor} · {m.context} · {m.inputPrice}→{m.outputPrice}</p>
              </div>
            </div>

            {/* Mini bars */}
            <div class="space-y-2">
              {bars.map(b => (
                <div class="flex items-center gap-2 text-xs">
                  <span class="w-14 shrink-0 text-gray-500 dark:text-gray-400 text-right">{b.label}</span>
                  <div class="flex-1 bg-gray-100 dark:bg-gray-800 rounded-full h-2 overflow-hidden">
                    <div
                      class="h-full rounded-full transition-all duration-700 ease-out"
                      style={`width:0%;background:${b.color}`}
                      data-bar-idx={`${idx}-${b.label}`}
                      data-width={Math.max(b.value, 2)}
                    ></div>
                  </div>
                  <span class="w-8 shrink-0 text-right font-bold text-gray-700 dark:text-gray-300">{b.raw}</span>
                </div>
              ))}
            </div>

            <p class="text-xs text-gray-400 mt-3 leading-relaxed italic">"{m.strengths}"</p>
          </div>
        );
      })}
    </div>

    <p class="mt-10 text-xs text-gray-400 text-center leading-relaxed">
      Elo 数据来源：<a href="https://arena.ai/leaderboard" class="text-brand-500 hover:underline" target="_blank" rel="noopener">LMSYS Chatbot Arena</a>（2026年6月）· 基于约 600 万次成对匿名投票<br/>
      编程/推理/知识评分综合 MMLU-Pro、HumanEval+、LiveCodeBench、GPQA 等公开基准归一化<br/>
      价格：每百万 Tokens 官方 API 报价 · 速度/性价比为相对评估
    </p>
  </div>
</Base>

<script define:vars={{ modelsJson }}>
    const MODELS = JSON.parse(modelsJson);

    const vendorColors = MODELS.map(m => m.vendorColor);
    const BENCH = ['Arena Elo','编程','推理','知识','多模态','速度','性价比'];
    const visible = new Set(MODELS.map(m => m.id));

    function normElo(e) { return ((e - 1400) / 150) * 100; }

    function buildDatasets() {
      return MODELS.filter(m => visible.has(m.id)).map(m => {
        var c = m.vendorColor;
        return {
          label: m.name,
          data: [normElo(m.arenaElo), m.coding, m.reasoning, m.knowledge, m.multimodal, m.speed, m.costEff],
          backgroundColor: c + 'AA',
          borderColor: c,
          borderWidth: 1,
          borderRadius: 4,
        };
      });
    }

    function updateBtns() {
      var ct = document.getElementById('bar-toggles');
      if (!ct) return;
      var dk = document.documentElement.classList.contains('dark');
      ct.querySelectorAll('button').forEach(function(b) {
        var c = b.dataset.color;
        if (visible.has(b.dataset.id)) {
          b.style.borderColor = c;
          b.style.color = c;
          b.style.background = dk ? 'rgba(255,255,255,0.04)' : 'rgba(0,0,0,0.03)';
          b.style.opacity = '1';
        } else {
          b.style.borderColor = dk ? '#1f2937' : '#e5e7eb';
          b.style.color = dk ? '#4b5563' : '#9ca3af';
          b.style.background = 'transparent';
          b.style.opacity = '0.5';
        }
      });
    }

    // Immediately animate mini-bars
    document.addEventListener('DOMContentLoaded', function() {
      var bars = document.querySelectorAll('[data-bar-idx]');
      bars.forEach(function(el, i) {
        setTimeout(function() {
          el.style.width = (el.dataset.width || '0') + '%';
        }, i * 30);
      });
    });

    // Load Chart.js
    (function() {
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
      s.onload = function() {
        var dk = document.documentElement.classList.contains('dark');
        var gc = dk ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
        var tc = dk ? '#9ca3af' : '#6b7280';
        var canvas = document.getElementById('barChart');
        if (!canvas) return;

        var chart = new Chart(canvas.getContext('2d'), {
          type: 'bar',
          data: { labels: BENCH, datasets: buildDatasets() },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            scales: {
              x: { ticks: { color: tc, font: { size: 11 } }, grid: { color: gc } },
              y: { min: 0, max: 100, ticks: { stepSize: 20, color: tc, font: { size: 10 } }, grid: { color: gc } }
            },
            plugins: {
              legend: { display: false },
              tooltip: { callbacks: { label: function(c) { return ' ' + c.dataset.label + ': ' + Math.round(c.raw) + '分'; } } }
            }
          }
        });

        var ct = document.getElementById('bar-toggles');
        MODELS.forEach(function(m) {
          var c = m.vendorColor;
          var b = document.createElement('button');
          b.dataset.id = m.id;
          b.dataset.color = c;
          b.className = 'px-3 py-1.5 rounded-full text-xs font-medium border transition-all duration-200 cursor-pointer active:scale-95';
          b.innerHTML = '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:' + c + ';margin-right:6px"></span>' + m.name;
          b.addEventListener('click', function() {
            if (visible.has(m.id)) { if (visible.size > 1) visible.delete(m.id); } else { visible.add(m.id); }
            chart.data.datasets = buildDatasets();
            chart.update();
            updateBtns();
          });
          ct.appendChild(b);
        });
        updateBtns();
      };
      document.head.appendChild(s);
    })();
  </script>